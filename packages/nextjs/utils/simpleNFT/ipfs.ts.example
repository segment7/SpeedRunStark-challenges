//lighthouse services
import lighthouse from '@lighthouse-web3/sdk'

// 请替换为你的 Lighthouse API Key
const apiKey = '01811d1c.a6896f33a5b845f1b9781480f7a2cbb5';

export const ipfsClient = {
  add: async (data: string) => {
    try {
      const response = await lighthouse.uploadText(data, apiKey);
      if (response.data) {
        return {
          path: response.data.Hash,
          cid: response.data.Hash,
          size: response.data.Size
        };
      }
      throw new Error('Upload failed');
    } catch (error) {
      console.error('Error uploading to Lighthouse:', error);
      throw error;
    }
  },
  
  // 添加 get 方法以保持 API 兼容性（虽然当前未使用）
  get: async (cid: string) => {
    try {
      const response = await fetch(`https://gateway.lighthouse.storage/ipfs/${cid}`);
      if (response.ok) {
        const content = await response.text();
        return content;
      }
      throw new Error(`Failed to fetch: ${response.statusText}`);
    } catch (error) {
      console.error('Error fetching from Lighthouse:', error);
      throw error;
    }
  }
};

export async function getNFTMetadataFromIPFS(ipfsHash: string) {
  try {
    const response = await fetch(`https://gateway.lighthouse.storage/ipfs/${ipfsHash}`);
    if (response.ok) {
      const content = await response.text();
      try {
        const jsonObject = JSON.parse(content);
        return jsonObject;
      } catch (error) {
        console.log("Error parsing JSON:", error);
        return undefined;
      }
    }
    throw new Error(`Failed to fetch metadata: ${response.statusText}`);
  } catch (error) {
    console.error('Error getting metadata from Lighthouse:', error);
    throw error;
  }
}
